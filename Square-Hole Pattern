package patterns;

import java.util.Scanner;

public class Squrepattern {

	public static void main(String[] args) {
		int n=6;
//		Scanner sc=new Scanner(System.in);
//		System.out.println("enter the number");
//		n=sc.nextInt();
		for(int i=0;i<=n;i++)
		{
			for(int j=0;j<=n;j++)
			{
				if(i==0 || j==0 || i==n || j==n)
				{
				System.out.print("*");
			}else
			{
		System.out.print(" ");	
		}
			}
				System.out.println();
			}
		// TODO Auto-generated method stub

	}

	}
